{
  "name": "aipm",
  "version": "1.0.0",
  "description": "AIPM (AI Package Manager) is a CLI tool to manage VS Code agent plugin marketplaces and install plugins for GitHub Copilot or Claude",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aipm": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,cts,mts,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "plugin",
    "marketplace",
    "cli",
    "github-copilot",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluelilyc/aipm.git"
  },
  "bugs": {
    "url": "https://github.com/bluelilyc/aipm/issues"
  },
  "homepage": "https://github.com/bluelilyc/aipm#readme",
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
